# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or Render Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Port for the Node.js server (Render automatically sets this)
PORT=3000

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Twitch OAuth Configuration for Bot Account (Jaafar / جعفر)
# Get these credentials from Twitch Developer Console: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
TWITCH_REDIRECT_URI="https://twitch-bot-jeffe.onrender.com/auth/twitch/callback"

# Target Broadcaster Twitch Channel Name (e.g. Jef's Twitch username)
TWITCH_BROADCASTER_LOGIN=""

# Optional Persistent Storage Path for Render (e.g. /var/data/twitch_auth.json)
# Defaults to /var/data/twitch_auth.json if Render disk is mounted, or ./.data/twitch_auth.json
TWITCH_STORAGE_PATH=""

# Optional Fallback Refresh Token: If set, bot can bootstrap auth without visiting /auth/twitch
TWITCH_REFRESH_TOKEN=""

# Optional Jito Permanent Twitch User ID (numeric ID from Twitch API)
# If left blank, the bot automatically resolves it from Twitch API for jitoheh / 4VREN
JITO_USER_ID=""

# Optional Secret Key for /chat-log page authentication
# Access via /chat-log?key=YOUR_SECRET or enter in page login prompt
CHAT_LOG_SECRET="jef8-jaafar-chat-log"

# General Web Search Configuration
# Enables Jaafar to search the web for fresh, real-time info (matches, news, release dates, etc.)
WEB_SEARCH_ENABLED=true
